// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  COACH
  ADMIN
}

enum ContentType {
  VIDEO
  EBOOK
  ARTIKEL
}

enum CoachingType {
  VIP_PRIVATE
  SMALL_GROUP
}

enum SessionStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

enum WebinarStatus {
  UPCOMING
  LIVE
  RECORDED
}

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  password         String?
  role             Role      @default(USER)
  subscription     String?   // SELF_LEARNING | SMALL_GROUP | null
  sub_end_date     DateTime?
  assessment_score Int?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  progress         UserProgress[]
  bookings         Booking[]
  goals            Goal[]
  transactions     Transaction[]
}

model Content {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  type        ContentType
  content_url String
  is_premium  Boolean     @default(true)
  module_id   String?
  chapter     Int?
  duration    Int?
  thumbnail_url String?

  progress    UserProgress[]
}

model UserProgress {
  id          String   @id @default(cuid())
  user_id     String
  content_id  String
  percent     Int      @default(0)
  completed   Boolean  @default(false)
  updated_at  DateTime @updatedAt

  user        User     @relation(fields: [user_id], references: [id])
  content     Content  @relation(fields: [content_id], references: [id])

  @@unique([user_id, content_id])
}

model CoachingSession {
  id            String         @id @default(cuid())
  type          CoachingType
  coach_id      String
  date_time     DateTime
  duration      Int
  max_seats     Int
  zoom_link     String?
  status        SessionStatus  @default(SCHEDULED)
  notes         String?

  bookings      Booking[]
}

model Booking {
  id            String         @id @default(cuid())
  user_id       String
  session_id    String?
  webinar_id    String?
  amount        Int
  status        PaymentStatus  @default(PENDING)
  midtrans_id   String?
  created_at    DateTime       @default(now())

  user          User           @relation(fields: [user_id], references: [id])
  session       CoachingSession? @relation(fields: [session_id], references: [id])
  webinar       Webinar?       @relation(fields: [webinar_id], references: [id])
}

model Webinar {
  id            String         @id @default(cuid())
  title         String
  slug          String         @unique
  description   String
  date_time     DateTime
  price         Int            @default(0)
  seats_total   Int
  seats_booked  Int            @default(0)
  status        WebinarStatus  @default(UPCOMING)
  zoom_link     String?
  recording_url String?
  thumbnail_url String?

  bookings      Booking[]
}

model Goal {
  id          String   @id @default(cuid())
  user_id     String
  title       String
  target      Int      // dalam rupiah
  current     Int      @default(0)
  deadline    DateTime?

  user        User     @relation(fields: [user_id], references: [id])
}

model Transaction {
  id          String        @id @default(cuid())
  user_id     String
  amount      Int
  description String
  status      PaymentStatus @default(PENDING)
  midtrans_id String?
  created_at  DateTime      @default(now())

  user        User          @relation(fields: [user_id], references: [id])
}
